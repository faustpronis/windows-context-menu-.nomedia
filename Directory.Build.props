<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>1.7.0</Version>
    <Company>FolderTools</Company>
    <Product>FolderTools</Product>
    <Copyright>FolderTools</Copyright>
    <!-- Source files contain Cyrillic strings and are stored as UTF-8 without BOM;
         force the compiler to read them as UTF-8 regardless of the machine codepage. -->
    <CodePage>65001</CodePage>
  </PropertyGroup>
</Project>
